generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assets {
  id                  BigInt                @id @default(autoincrement())
  asset_code          String                @unique @db.VarChar(50)
  name                String                @db.VarChar(150)
  category            String                @db.VarChar(50)
  brand               String?               @db.VarChar(100)
  serial_number       String?               @db.VarChar(100)
  location            String                @db.VarChar(150)
  assigned_to         BigInt?
  department_id       BigInt
  status              String                @default("ACTIVE") @db.VarChar(20)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  users               users?                @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assets_assigned_user")
  departments         departments           @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assets_department")
  maintenance_tickets maintenance_tickets[]
}

model departments {
  id         BigInt   @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  assets     assets[]
  users      users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model maintenance_tickets {
  id                                           BigInt    @id @default(autoincrement())
  ticket_code                                  String    @unique @db.VarChar(50)
  asset_id                                     BigInt
  created_by                                   BigInt
  approved_by                                  BigInt?
  status                                       String    @default("PENDING") @db.VarChar(20)
  priority                                     String    @default("MEDIUM") @db.VarChar(10)
  problem                                      String    @db.VarChar(200)
  description                                  String?
  rejection_reason                             String?
  completion_notes                             String?
  started_at                                   DateTime? @db.Timestamp(6)
  completed_at                                 DateTime? @db.Timestamp(6)
  created_at                                   DateTime  @default(now()) @db.Timestamp(6)
  updated_at                                   DateTime  @default(now()) @db.Timestamp(6)
  users_maintenance_tickets_approved_byTousers users?    @relation("maintenance_tickets_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tickets_approver")
  assets                                       assets    @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tickets_asset")
  users_maintenance_tickets_created_byTousers  users     @relation("maintenance_tickets_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tickets_creator")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                                         BigInt                @id @default(autoincrement())
  name                                                       String                @db.VarChar(100)
  email                                                      String                @unique @db.VarChar(150)
  password                                                   String                @db.VarChar(255)
  role                                                       String                @db.VarChar(10)
  department_id                                              BigInt
  created_at                                                 DateTime              @default(now()) @db.Timestamp(6)
  updated_at                                                 DateTime              @default(now()) @db.Timestamp(6)
  assets                                                     assets[]
  maintenance_tickets_maintenance_tickets_approved_byTousers maintenance_tickets[] @relation("maintenance_tickets_approved_byTousers")
  maintenance_tickets_maintenance_tickets_created_byTousers  maintenance_tickets[] @relation("maintenance_tickets_created_byTousers")
  departments                                                departments           @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_department")
}
